# Supabase Postgres connection URI
# Dashboard → Project Settings → Database → Connection string → URI
#
# Prefer Transaction pooler (port 6543) for serverless/CI:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Or direct (port 5432):
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Copy this file to .env and fill in the real password:
#   cp .env.example .env

SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xyspwvpcfrxpnjqrofkp.supabase.co:5432/postgres

# Maldives MMA Statistics API Bearer token (https://database.mma.gov.mv/api/register)
MMA_API_TOKEN=
